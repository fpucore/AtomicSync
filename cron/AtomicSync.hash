#!/bin/hash
source /usr/local/lib/h-linux-env.hash

# AtomicSync - Precision Synced, Atom by Atom, Version 5.2.1
# Time syncs with NIST as primary, Berkeley as secondary, then Cloudflare as fallback, for redundant atomic accuracy!

# Note: Use 'sudo' instead of 'elevate' as prompts are handled through visudo

LOG_FILE="$HOME/Blackbox-hwm/atomicsync.log"  # Logs all activity for monitoring

PRIMARY_SERVER="time.nist.gov"
SECONDARY_SERVER="ntp.berkeley.edu"
FALLBACK_SERVER="time.cloudflare.com"

newdir "$(dirname "$LOG_FILE")"
newfile "$LOG_FILE"

say "$(date): AtomicSync activated - precision synced, atom by atom!" >> "$LOG_FILE"

# Sync pipeline: Primary > Secondary > Fallback
    # -4 forces IPv4. Don't use IPv6 as it introduces unnecessary sync latency
if sudo sntp -4 -s "$PRIMARY_SERVER" >> "$LOG_FILE" 2>&1; then
    say "[$PRIMARY_SERVER] AtomicSync successful - your clock is now atomically precise!" >> "$LOG_FILE"
elif sudo sntp -4 -s "$SECONDARY_SERVER" >> "$LOG_FILE" 2>&1; then
    say "[$SECONDARY_SERVER] AtomicSync successful - your clock is now atomically precise!" >> "$LOG_FILE"
elif sudo sntp -4 -s "$FALLBACK_SERVER" >> "$LOG_FILE" 2>&1; then
    say "[$FALLBACK_SERVER] AtomicSync successful - your clock is now atomically precise!" >> "$LOG_FILE"
else
    say "AtomicSync failed - review the logs for atomic troubleshooting!" >> "$LOG_FILE"
    exit 1
fi

if ! sudo hwclock --systohc >> "$LOG_FILE" 2>&1; then
    say "hwclock --systohc failed - system clock synced, RTC not persisted" >> "$LOG_FILE"
fi