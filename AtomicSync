#!/bin/bash

# AtomicSync - Precision Synced, Atom by Atom, Version 2.0.0
# Time syncs with NIST primary and Berkeley secondary for atomic accuracy!

LOG_FILE="$HOME/Blackbox-hwm/atomicsync.log"  # Logs all activity for monitoring
PRIMARY_SERVER="time.nist.gov"
SECONDARY_SERVER="ntp.berkeley.edu"

mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"

echo "$(date): AtomicSync activated - precision synced, atom by atom!" >> "$LOG_FILE"

# Sync primary first, secondary as backup
if sudo sntp -s "$PRIMARY_SERVER" >> "$LOG_FILE" 2>&1; then
    echo "[$PRIMARY_SERVER] AtomicSync successful - your clock is now atomically precise!" >> "$LOG_FILE"
elif sudo sntp -s "$SECONDARY_SERVER" >> "$LOG_FILE" 2>&1; then
    echo "[$SECONDARY_SERVER] AtomicSync successful - your clock is now atomically precise!" >> "$LOG_FILE"
else
    echo "AtomicSync failed - review the logs for atomic troubleshooting!" >> "$LOG_FILE"
    exit 1
fi

sudo hwclock --systohc >> "$LOG_FILE" 2>&1
